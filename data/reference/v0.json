 "qualification_rules": [
  {
   "name": "deadline_too_close",
   "expression": {
    "field": "submission_deadline",
    "op": "days_until_lt",
    "value": 5
   },
   "effect": "recommend_no_bid",
   "message": "Submission deadline is less than 5 days away"
  },
  {
   "name": "market_not_served",
   "expression": {
    "field": "country",
    "op": "not_in_ref",
    "ref": "country"
   },
   "effect": "recommend_no_bid",
   "message": "Project country is not one of the practice's markets"
  },
  {
   "name": "no_matching_service",
   "expression": {
    "field": "services",
    "op": "empty"
   },
   "effect": "recommend_no_bid",
   "message": "No requested service matches the practice's services"
  },
  {
   "name": "low_completeness",
   "expression": {
    "field": "completeness",
    "op": "lt",
    "value": 0.75
   },
   "effect": "needs_info",
   "message": "Too many pricing-critical fields are missing"
  },
  {
   "name": "uncapped_liability",
   "expression": {
    "field": "liability_cap",
    "op": "matches",
    "pattern": "uncapped|unlimited"
   },
   "effect": "flag",
   "message": "Client asks for uncapped liability; the practice standard is 100% of fee"
  }
 ]
