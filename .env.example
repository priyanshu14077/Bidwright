POSTGRES_PORT=5434
POSTGRES_SUPERUSER_PASSWORD=postgres
SOG_DB_PASSWORD=sog
N8N_DB_PASSWORD=n8n
SOG_DATABASE_URL=postgresql+psycopg://sog:sog@localhost:5434/sog
SOG_DATASET_VERSION=v0-synthetic
SOG_STORAGE_DIR=var/blobs
ANTHROPIC_API_KEY=
SOG_MODEL_EXTRACT=claude-haiku-4-5
SOG_MODEL_CLASSIFY=claude-haiku-4-5
# Set explicitly so a shell-level ANTHROPIC_BASE_URL (e.g. a local proxy) is never inherited
SOG_ANTHROPIC_BASE_URL=https://api.anthropic.com
SOG_LIBREOFFICE=/Applications/LibreOffice.app/Contents/MacOS/soffice
SOG_PRISMA_PASSWORD=sog_prisma
# Prisma reads this (prisma/prisma.config.ts). DML-only role; Alembic owns the schema.
SOG_PRISMA_DATABASE_URL=postgresql://sog_prisma:sog_prisma@localhost:5434/sog
