POSTGRES_PORT=5434
# Database passwords. Leave them empty here: `make env` copies this file to .env and fills each one
# with a random value. Never commit .env.
POSTGRES_SUPERUSER_PASSWORD=
BIDWRIGHT_DB_PASSWORD=
BIDWRIGHT_APP_PASSWORD=
BIDWRIGHT_STUDIO_PASSWORD=
N8N_DB_PASSWORD=
BIDWRIGHT_DATASET_VERSION=v0-synthetic
BIDWRIGHT_STORAGE_DIR=var/blobs
ANTHROPIC_API_KEY=
BIDWRIGHT_MODEL_EXTRACT=claude-haiku-4-5
BIDWRIGHT_MODEL_CLASSIFY=claude-haiku-4-5
# Set explicitly so a shell-level ANTHROPIC_BASE_URL (e.g. a local proxy) is never inherited
BIDWRIGHT_ANTHROPIC_BASE_URL=https://api.anthropic.com
BIDWRIGHT_LIBREOFFICE=/Applications/LibreOffice.app/Contents/MacOS/soffice
