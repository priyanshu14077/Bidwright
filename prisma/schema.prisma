generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  schemas  = ["archive", "eval", "intake", "lineage", "ref", "tenancy"]
}

model client {
  org_id                          String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  client_id                       String
  dataset_version                 String
  name                            String
  client_type                     String?
  country                         String?      @db.Char(2)
  first_engaged                   DateTime?    @db.Date
  country_client_countryTocountry country?     @relation("client_countryTocountry", fields: [country], references: [code], onDelete: NoAction, onUpdate: NoAction)
  organization                    organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  proposal                        proposal[]

  @@id([org_id, client_id])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "client_name_trgm", type: Gin)
  @@schema("archive")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model dataset {
  org_id          String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  dataset_version String
  name            String
  data_origin     String
  generated       DateTime?    @db.Date
  record_count    Int?
  warning         String?
  loaded_at       DateTime     @default(now()) @db.Timestamptz(6)
  organization    organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([org_id, dataset_version])
  @@schema("archive")
}

model deliverable {
  org_id       String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  proposal_id  String
  item         String
  qty          Int?
  organization organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  proposal     proposal     @relation(fields: [org_id, proposal_id], references: [org_id, proposal_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([org_id, proposal_id, item])
  @@schema("archive")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model fee_line {
  org_id                            String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  proposal_id                       String
  line_no                           Int
  service                           String
  stage                             String
  basis                             String?
  basis_qty                         Decimal?     @db.Decimal
  basis_unit                        String?
  amount_local                      Decimal      @db.Decimal
  amount_usd                        Decimal?     @db.Decimal
  organization                      organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  proposal                          proposal     @relation(fields: [org_id, proposal_id], references: [org_id, proposal_id], onDelete: Cascade, onUpdate: NoAction)
  service_fee_line_serviceToservice service      @relation("fee_line_serviceToservice", fields: [service], references: [code], onDelete: NoAction, onUpdate: NoAction)
  stage_fee_line_stageTostage       stage        @relation("fee_line_stageTostage", fields: [stage], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@id([org_id, proposal_id, line_no])
  @@schema("archive")
}

model payment_milestone {
  org_id       String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  proposal_id  String
  seq          Int
  milestone    String
  pct          Decimal      @db.Decimal(5, 2)
  amount_local Decimal?     @db.Decimal
  organization organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  proposal     proposal     @relation(fields: [org_id, proposal_id], references: [org_id, proposal_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([org_id, proposal_id, seq])
  @@schema("archive")
}

model pricing_trace {
  trace_id     BigInt       @id @default(autoincrement())
  org_id       String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  proposal_id  String
  factor       String
  value        String?
  source       String?
  note         String?
  organization organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  proposal     proposal     @relation(fields: [org_id, proposal_id], references: [org_id, proposal_id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("archive")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model proposal {
  org_id                               String              @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  proposal_id                          String
  dataset_version                      String
  reference                            String
  title                                String
  data_origin                          String
  studio_code                          String?
  client_id                            String?
  client_status                        String?
  location_id                          Int?
  typology                             String?
  sub_typology                         String?
  gfa_m2                               Decimal?            @db.Decimal
  site_area_m2                         Decimal?            @db.Decimal
  landscape_area_m2                    Decimal?            @db.Decimal
  fitout_area_m2                       Decimal?            @db.Decimal
  units                                Int?
  keys                                 Int?
  complexity                           String?
  complexity_notes                     String?
  submission_date                      DateTime?           @db.Date
  currency                             String?             @db.Char(3)
  fx_per_usd                           Decimal?            @db.Decimal(14, 6)
  construction_cost_usd_m2             Decimal?            @db.Decimal
  fee_total_local                      Decimal?            @db.Decimal
  fee_total_usd                        Decimal?            @db.Decimal
  status                               String?
  outcome_date                         DateTime?           @db.Date
  loss_reason                          String?
  project_challenges                   String?
  cost_city                            String?
  document_variations                  Json?
  schema_version                       String              @default("0.1")
  created_at                           DateTime            @default(now()) @db.Timestamptz(6)
  deliverable                          deliverable[]
  fee_line                             fee_line[]
  payment_milestone                    payment_milestone[]
  pricing_trace                        pricing_trace[]
  client                               client?             @relation(fields: [org_id, client_id], references: [org_id, client_id], onDelete: NoAction, onUpdate: NoAction)
  organization                         organization        @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  location                             location?           @relation(fields: [org_id, location_id], references: [org_id, location_id], onDelete: NoAction, onUpdate: NoAction)
  studio                               studio?             @relation(fields: [org_id, studio_code], references: [org_id, code], onDelete: NoAction, onUpdate: NoAction)
  typology_proposal_typologyTotypology typology?           @relation("proposal_typologyTotypology", fields: [typology], references: [code], onDelete: NoAction, onUpdate: NoAction)
  proposal_section                     proposal_section[]
  proposal_service                     proposal_service[]
  proposal_stage                       proposal_stage[]
  reimbursable                         reimbursable[]
  tc_deviation                         tc_deviation[]
  gold_case                            gold_case[]
  field_value                          field_value[]
  source_document                      source_document[]

  @@id([org_id, proposal_id])
  @@unique([org_id, reference])
  @@index([org_id, dataset_version], map: "proposal_dataset")
  @@schema("archive")
}

model proposal_section {
  section_id   BigInt       @id @default(autoincrement())
  org_id       String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  proposal_id  String
  seq          Int
  section_code String
  heading      String
  service      String?
  stage        String?
  body         String
  organization organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  proposal     proposal     @relation(fields: [org_id, proposal_id], references: [org_id, proposal_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([org_id, proposal_id, seq])
  @@schema("archive")
}

model proposal_service {
  org_id                                    String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  proposal_id                               String
  service                                   String
  organization                              organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  proposal                                  proposal     @relation(fields: [org_id, proposal_id], references: [org_id, proposal_id], onDelete: Cascade, onUpdate: NoAction)
  service_proposal_service_serviceToservice service      @relation("proposal_service_serviceToservice", fields: [service], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@id([org_id, proposal_id, service])
  @@schema("archive")
}

model proposal_stage {
  org_id                            String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  proposal_id                       String
  stage                             String
  organization                      organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  proposal                          proposal     @relation(fields: [org_id, proposal_id], references: [org_id, proposal_id], onDelete: Cascade, onUpdate: NoAction)
  stage_proposal_stage_stageTostage stage        @relation("proposal_stage_stageTostage", fields: [stage], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@id([org_id, proposal_id, stage])
  @@schema("archive")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reimbursable {
  org_id          String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  proposal_id     String
  type            String
  qty             Int?
  unit_rate_local Decimal?     @db.Decimal
  amount_local    Decimal?     @db.Decimal
  note            String?
  organization    organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  proposal        proposal     @relation(fields: [org_id, proposal_id], references: [org_id, proposal_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([org_id, proposal_id, type])
  @@schema("archive")
}

model tc_deviation {
  org_id         String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  proposal_id    String
  clause         String
  client_request String?
  firm_position  String?
  organization   organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  proposal       proposal     @relation(fields: [org_id, proposal_id], references: [org_id, proposal_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([org_id, proposal_id, clause])
  @@schema("archive")
}

model case_result {
  org_id       String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  run_id       BigInt
  case_id      String
  envelope_id  BigInt?
  detail       Json
  envelope     envelope?    @relation(fields: [envelope_id], references: [envelope_id], onUpdate: NoAction)
  organization organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  run          run          @relation(fields: [run_id], references: [run_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([run_id, case_id])
  @@schema("eval")
}

model field_result {
  org_id       String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  run_id       BigInt
  case_id      String
  field        String
  truth        Json?
  got          Json?
  ok           Boolean
  organization organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  run          run          @relation(fields: [run_id], references: [run_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([run_id, case_id, field])
  @@schema("eval")
}

model gold_case {
  org_id           String          @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  dataset_version  String
  case_id          String
  proposal_id      String
  style            String?
  issued_at        DateTime        @db.Timestamptz(6)
  traps            String[]        @default([])
  special_requests String[]        @default([])
  envelope_id      BigInt?
  envelope         envelope?       @relation(fields: [envelope_id], references: [envelope_id], onUpdate: NoAction)
  organization     organization    @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  proposal         proposal        @relation(fields: [org_id, proposal_id], references: [org_id, proposal_id], onDelete: Cascade, onUpdate: NoAction)
  gold_conflict    gold_conflict[]
  gold_truth       gold_truth[]

  @@id([org_id, dataset_version, case_id])
  @@schema("eval")
}

model gold_conflict {
  org_id          String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  dataset_version String
  case_id         String
  field           String
  values          Json
  documents       String[]
  gold_case       gold_case    @relation(fields: [org_id, dataset_version, case_id], references: [org_id, dataset_version, case_id], onDelete: Cascade, onUpdate: NoAction)
  organization    organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([org_id, dataset_version, case_id, field])
  @@schema("eval")
}

model gold_truth {
  org_id          String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  dataset_version String
  case_id         String
  field           String
  value           Json?
  gold_case       gold_case    @relation(fields: [org_id, dataset_version, case_id], references: [org_id, dataset_version, case_id], onDelete: Cascade, onUpdate: NoAction)
  organization    organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([org_id, dataset_version, case_id, field])
  @@schema("eval")
}

model run {
  run_id          BigInt         @id @default(autoincrement())
  org_id          String         @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  run_at          DateTime       @default(now()) @db.Timestamptz(6)
  dataset_version String
  model           String?
  prompt_version  String?
  engine_version  String?
  summary         Json
  case_result     case_result[]
  field_result    field_result[]
  organization    organization   @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("eval")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model engine_flag {
  flag_id        BigInt          @id @default(autoincrement())
  org_id         String          @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  envelope_id    BigInt
  run_id         BigInt?
  field_value_id BigInt?
  field          String?
  rule           String
  severity       String
  message        String
  evidence       Json?
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  envelope       envelope        @relation(fields: [envelope_id], references: [envelope_id], onDelete: Cascade, onUpdate: NoAction)
  field_value    field_value?    @relation(fields: [field_value_id], references: [field_value_id], onDelete: NoAction, onUpdate: NoAction)
  organization   organization    @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  extraction_run extraction_run? @relation(fields: [run_id], references: [run_id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("intake")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model envelope {
  envelope_id                       BigInt            @id @default(autoincrement())
  org_id                            String            @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  title                             String?
  channel                           String
  sender                            String?
  subject                           String?
  received_at                       DateTime          @default(now()) @db.Timestamptz(6)
  status                            String            @default("received")
  lead_status                       String?
  completeness                      Decimal?          @db.Decimal(4, 3)
  country                           String?           @db.Char(2)
  location_id                       Int?
  billing_currency                  String?           @db.Char(3)
  routed_studio                     String?
  submission_deadline               DateTime?         @db.Timestamptz(6)
  owner                             String?
  dataset_version                   String
  error                             String?
  created_at                        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at                        DateTime          @default(now()) @db.Timestamptz(6)
  case_result                       case_result[]
  gold_case                         gold_case[]
  engine_flag                       engine_flag[]
  country_envelope_countryTocountry country?          @relation("envelope_countryTocountry", fields: [country], references: [code], onDelete: NoAction, onUpdate: NoAction)
  organization                      organization      @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  location                          location?         @relation(fields: [org_id, location_id], references: [org_id, location_id], onDelete: NoAction, onUpdate: NoAction)
  studio                            studio?           @relation(fields: [org_id, routed_studio], references: [org_id, code], onDelete: NoAction, onUpdate: NoAction)
  extraction_run                    extraction_run[]
  field_conflict                    field_conflict[]
  opportunity                       opportunity[]
  field_value                       field_value[]
  source_document                   source_document[]

  @@unique([org_id, envelope_id])
  @@index([org_id, received_at(sort: Desc)], map: "envelope_received")
  @@schema("intake")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model extraction_run {
  run_id          BigInt           @id @default(autoincrement())
  org_id          String           @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  envelope_id     BigInt
  document_id     BigInt?
  kind            String
  model           String?
  prompt_version  String?
  schema_version  String
  engine_version  String?
  dataset_version String
  status          String           @default("running")
  trace_id        String           @db.Uuid
  error           String?
  started_at      DateTime         @default(now()) @db.Timestamptz(6)
  finished_at     DateTime?        @db.Timestamptz(6)
  engine_flag     engine_flag[]
  source_document source_document? @relation(fields: [document_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
  envelope        envelope         @relation(fields: [envelope_id], references: [envelope_id], onDelete: Cascade, onUpdate: NoAction)
  organization    organization     @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  llm_call        llm_call[]
  field_value     field_value[]

  @@index([envelope_id], map: "extraction_run_envelope")
  @@schema("intake")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model field_conflict {
  conflict_id       BigInt       @id @default(autoincrement())
  org_id            String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  envelope_id       BigInt
  field             String
  field_value_ids   BigInt[]
  summary           String
  status            String       @default("open")
  resolved_value_id BigInt?
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  envelope          envelope     @relation(fields: [envelope_id], references: [envelope_id], onDelete: Cascade, onUpdate: NoAction)
  organization      organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  field_value       field_value? @relation(fields: [resolved_value_id], references: [field_value_id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("intake")
}

model llm_call {
  call_id            BigInt          @id @default(autoincrement())
  org_id             String          @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  run_id             BigInt?
  trace_id           String          @db.Uuid
  attempt            Int
  model              String
  prompt_version     String
  request_hash       String          @db.Char(64)
  input_tokens       Int?
  output_tokens      Int?
  cache_read_tokens  Int?
  cache_write_tokens Int?
  latency_ms         Int?
  cost_usd           Decimal?        @db.Decimal(10, 6)
  stop_reason        String?
  response           Json?
  validation_error   String?
  error              String?
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  organization       organization    @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  extraction_run     extraction_run? @relation(fields: [run_id], references: [run_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([trace_id], map: "llm_call_trace")
  @@schema("intake")
}

model opportunity {
  org_id         String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  envelope_id    BigInt
  version        Int
  record         Json
  schema_version String
  confirmed_by   String
  confirmed_at   DateTime     @default(now()) @db.Timestamptz(6)
  envelope       envelope     @relation(fields: [envelope_id], references: [envelope_id], onDelete: NoAction, onUpdate: NoAction)
  organization   organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([envelope_id, version])
  @@schema("intake")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model field_change {
  change_id                                                BigInt       @id @default(autoincrement())
  org_id                                                   String       @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  field                                                    String
  old_field_value_id                                       BigInt?
  new_field_value_id                                       BigInt?
  old_value                                                Json?
  new_value                                                Json?
  action                                                   String
  reason                                                   String
  changed_by                                               String
  changed_at                                               DateTime     @default(now()) @db.Timestamptz(6)
  field_value_field_change_new_field_value_idTofield_value field_value? @relation("field_change_new_field_value_idTofield_value", fields: [new_field_value_id], references: [field_value_id], onDelete: NoAction, onUpdate: NoAction)
  field_value_field_change_old_field_value_idTofield_value field_value? @relation("field_change_old_field_value_idTofield_value", fields: [old_field_value_id], references: [field_value_id], onDelete: NoAction, onUpdate: NoAction)
  organization                                             organization @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("lineage")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model field_value {
  field_value_id                                            BigInt           @id @default(autoincrement())
  org_id                                                    String           @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  proposal_id                                               String?
  envelope_id                                               BigInt?
  run_id                                                    BigInt?
  field                                                     String
  value                                                     Json?
  normalized                                                Json?
  document_id                                               BigInt?
  page                                                      Int?
  quote                                                     String?
  bbox                                                      Json?
  confidence                                                Decimal?         @db.Decimal(4, 3)
  origin                                                    String
  kind                                                      String           @default("fact")
  status                                                    String           @default("proposed")
  created_at                                                DateTime         @default(now()) @db.Timestamptz(6)
  engine_flag                                               engine_flag[]
  field_conflict                                            field_conflict[]
  field_change_field_change_new_field_value_idTofield_value field_change[]   @relation("field_change_new_field_value_idTofield_value")
  field_change_field_change_old_field_value_idTofield_value field_change[]   @relation("field_change_old_field_value_idTofield_value")
  source_document                                           source_document? @relation(fields: [document_id], references: [document_id], onDelete: NoAction, onUpdate: NoAction)
  envelope                                                  envelope?        @relation(fields: [envelope_id], references: [envelope_id], onDelete: Cascade, onUpdate: NoAction)
  organization                                              organization     @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)
  proposal                                                  proposal?        @relation(fields: [org_id, proposal_id], references: [org_id, proposal_id], onDelete: Cascade, onUpdate: NoAction)
  extraction_run                                            extraction_run?  @relation(fields: [run_id], references: [run_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([envelope_id, field], map: "field_value_envelope")
  @@index([org_id, proposal_id, field], map: "field_value_proposal")
  @@schema("lineage")
}

model page {
  org_id          String          @default(dbgenerated("tenancy.current_org()")) @db.Uuid
  document_id     BigInt
  page_no         Int
  width           Decimal         @db.Decimal
  height          Decimal         @db.Decimal
  lines           Json
  source_document source_document @relation(fields: [document_id], references: [document_id], onDelete: Cascade, onUpdate: NoAction)
  organization    organization    @relation(fields: [org_id], references: [org_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([document_id, page_no])
